rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Employee reference photos (uploaded by admin during account creation)
    match /employee_photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Attendance photos (uploaded by employees during check-in / check-out)
    match /attendance_photos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
