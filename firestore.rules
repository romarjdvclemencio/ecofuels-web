rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper function ----
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Users ----
    match /users/{userId} {
      // Any authenticated user can read their own doc; admins can read all
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Only admins can create employee documents
      allow create: if isAdmin();

      // A user can update their own doc (e.g. sessionToken on login)
      // Admins can update any doc
      allow update: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ---- Departments ----
    match /departments/{deptId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ---- Attendance records ----
    match /attendance/{attId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // ---- Settings ----
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---- Meta ----
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- Chat Rooms ----
    match /chatRooms/{roomId} {
      allow read: if request.auth != null;
      // Admin can create/update/delete any room
      // Any authenticated user can create a DM room if they are one of the members
      allow create: if request.auth != null
        && (isAdmin()
            || (request.resource.data.type == "dm"
                && request.resource.data.members.hasAll([request.auth.uid])));
      allow update, delete: if isAdmin();
    }

    // ---- Chat Messages ----
    match /chatRooms/{roomId}/messages/{msgId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ---- Request Types ----
    match /requestTypes/{typeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ---- Work Days (calendar restrictions set by admin) ----
    match /workDays/{dateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---- Requests ----
    match /requests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.employeeId == request.auth.uid || isAdmin());
      allow create: if request.auth != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
